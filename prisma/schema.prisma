generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String    @id @default(cuid())
  riotId     String    @unique // "GameName#TAG"
  puuid      String    @unique
  region     String    // e.g. "na1", "euw1"
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Account tier: "guest" = Riot ID only, "full" = email + password
  accountType   String  @default("guest")
  email         String? @unique
  passwordHash  String?
  emailVerified Boolean @default(false)

  isPremium            Boolean  @default(false)
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?  @unique

  sessions         Session[]
  queueEntry       QueueEntry?
  partnerPost      PartnerPost?
  coachProfile     CoachProfile?
  studentSessions  CoachingSession[] @relation("StudentSessions")
  matchesAsA       Match[]     @relation("MatchPlayerA")
  matchesAsB       Match[]     @relation("MatchPlayerB")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique @default(cuid())
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
}

model QueueEntry {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  myChampion   String   // champion the user wants to play
  vsChampions  String   // JSON array e.g. '["Darius","Garen"]' or '["_any"]'
  eloBracket   String   // "low" | "mid" | "high" | "elite" | "apex"
  createdAt    DateTime @default(now())

  @@index([myChampion, eloBracket])
}

model PartnerPost {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  myChampions  String   // JSON string[] — champions the poster plays
  vsChampions  String   // JSON string[] — champions they want to face
  eloBracket   String   // "low" | "mid" | "high" | "elite" | "apex"
  availability String   // JSON string[] — e.g. ["evening","weekends"]
  notes        String?  // optional free-text, max 300 chars
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([eloBracket])
}

// ── Coaching ──────────────────────────────────────────────────────────────────

model CoachProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Short code shown instead of Riot ID before a session is booked (e.g. "A7F2")
  displayCode  String   @unique
  verifiedTier String   // "MASTER" | "GRANDMASTER" | "CHALLENGER"
  champions    String   // JSON string[] — champion pool
  specialties  String   // JSON string[] — matchups / roles they coach
  hourlyRate   Int      // in cents, e.g. 3000 = $30/hr
  bio          String?  // max 500 chars
  availability String   // JSON string[] — time slot IDs
  isActive     Boolean  @default(true)
  // Manually approved by the site owner via scripts/manage-coaches.ts
  isApproved   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions     CoachingSession[] @relation("CoachSessions")

  @@index([isActive, isApproved])
}

model CoachingSession {
  id              String       @id @default(cuid())
  coachProfileId  String
  coachProfile    CoachProfile @relation("CoachSessions", fields: [coachProfileId], references: [id])
  studentId       String
  student         User         @relation("StudentSessions", fields: [studentId], references: [id])
  durationMinutes Int          // 30 | 60 | 90
  rateAtBooking   Int          // hourlyRate in cents at booking time
  totalCharged    Int          // student pays this (cents)
  platformFee     Int          // 20% cut (cents)
  stripeSessionId String?      // Stripe Checkout Session ID
  status          String       @default("pending_payment") // "pending_payment" | "confirmed" | "completed" | "cancelled"
  createdAt       DateTime     @default(now())

  @@index([coachProfileId])
  @@index([studentId])
  @@index([status])
}

model Match {
  id         String   @id @default(cuid())
  playerAId  String
  playerBId  String
  playerA    User     @relation("MatchPlayerA", fields: [playerAId], references: [id])
  playerB    User     @relation("MatchPlayerB", fields: [playerBId], references: [id])
  champA     String   // playerA's champion
  champB     String   // playerB's champion
  eloBracket String
  createdAt  DateTime @default(now())

  // Outcome reporting — set once each player self-reports
  playerAReport String?   // "win" | "loss"
  playerBReport String?   // "win" | "loss"
  // Confirmed when both reports agree; "DISPUTED" when they contradict
  outcome       String?   // "A_WIN" | "B_WIN" | "DISPUTED"

  @@index([playerAId])
  @@index([playerBId])
  @@index([outcome])
}
